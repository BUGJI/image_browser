{
  "name": "image-browser",
  "version": "1.1.0",
  "description": "本地 / 远程图片浏览器：瀑布流浏览、OCR 图内文字与 AI 语义搜索、标签与收藏",
  "main": "./out/main/index.js",
  "author": "BUGJI",
  "homepage": "https://github.com/BUGJI",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:win:zip": "electron-vite build && electron-builder --win zip --x64",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:ocr-addon": "node scripts/build-ocr-addon.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.4",
    "extract-zip": "^2.0.1",
    "jpeg-js": "^0.4.4",
    "omggif": "^1.0.10",
    "pinia": "^4.0.2",
    "pngjs": "^7.0.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "webdav": "^5.10.0",
    "webp-wasm": "^1.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "adm-zip": "^0.6.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6"
  },
  "optionalDependencies": {
    "@repeato/ocr": "^1.5.21",
    "sharp": "^0.34.5"
  }
}
